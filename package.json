{
  "name": "ardudeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ArduDeck - a dedicated classroom console for physical computing",
  "workspaces": [
    "apps/*",
    "core",
    "desktop"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:ui": "node tools/dev.mjs --ui-only",
    "dev:api": "node tools/dev.mjs --api-only",
    "desktop:dev": "node tools/desktop.mjs",
    "desktop:build": "npm run check",
    "desktop:package": "node tools/package-win.mjs",
    "build": "npm run build --workspace @ardudeck/ui",
    "typecheck": "npm run typecheck --workspace @ardudeck/core && npm run typecheck --workspace @ardudeck/ui",
    "lint": "eslint core/src core/tests apps/ui/src",
    "test": "npm run test --workspace @ardudeck/core",
    "test:api": "node tools/pytest.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "engines": {
    "node": ">=18.18"
  }
}
